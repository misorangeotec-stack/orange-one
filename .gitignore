# Secrets & credentials — NEVER commit these
.env
credentials.json
token.json
*.pem
*.key

# Leads → Google export (leads_export/) — Google OAuth secrets + local env
leads_export/credentials.json
leads_export/token*.json
leads_export/.env

# Temporary / regenerable files
.tmp/
*.log

# Database backups — contain real user data (PII). NEVER commit.
backups/
*.dump
*.sql.gz

# Node / frontend (React + Vite)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/*.local
.vite/

# Mobile app (Expo / React Native)
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/.env
mobile/*.local
mobile/expo-env.d.ts
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Supabase CLI scratch state
supabase/.temp/

# Claude Code local runtime state (lock files, session scratch)
.claude/

# Local business documents — PDFs / Word / Excel reference material, not source.
# Kept on disk for working reference; never committed.
Misc/
SOP/
files/
FMS/

# Generated data extracts (.xlsx exception reports etc). Regenerate from the
# ConnectWave mirror rather than committing a snapshot of live customer data.
output/

# Cora's generated analytics index — tool state, rebuilt on demand.
.cora/

# Word/PDF reference material that happens to sit under docs/. The prose notes
# in docs/ ARE committed; the binaries follow the Misc/ SOP/ rule above.
docs/**/*.doc
docs/**/*.docx
docs/**/*.pdf
